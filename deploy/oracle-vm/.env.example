# Copy to .env (gitignored) in this same directory.
POSTGRES_PASSWORD="generate-a-long-random-password"
# Subdomain pointing (A record) to the VM's public IP — Caddy uses this to
# request a free Let's Encrypt certificate automatically. Must be reachable
# on ports 80/443 from the internet for the certificate challenge to work.
API_DOMAIN="api.seudominio.com"
