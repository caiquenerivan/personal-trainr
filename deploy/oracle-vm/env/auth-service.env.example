# Copy to auth-service.env (gitignored) and fill in real production values.
# "postgres" below is the compose service name, not localhost.
DATABASE_URL="postgresql://personaltrainr:CHANGE_ME_SAME_AS_POSTGRES_PASSWORD@postgres:5432/personaltrainr?schema=public"
JWT_SECRET="generate-a-long-random-secret-do-not-use-this-value"
# Must be the exact same value as api-gateway's and workout-service's INTERNAL_SERVICE_SECRET.
INTERNAL_SERVICE_SECRET="generate-a-long-random-secret-shared-with-auth-and-workout-service"
PORT=3001
CORS_ORIGIN="https://your-frontend-domain.com"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
FRONTEND_URL="https://your-frontend-domain.com"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
ASAAS_API_URL="https://api.asaas.com/v3"
ASAAS_API_KEY=""
ASAAS_WEBHOOK_TOKEN="generate-a-long-random-secret-do-not-use-this-value"
RATE_LIMIT_MAX="100"
