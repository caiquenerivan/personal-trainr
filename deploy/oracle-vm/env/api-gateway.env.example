# Copy to api-gateway.env (gitignored) and fill in real production values.
JWT_SECRET="generate-a-long-random-secret-do-not-use-this-value"
# Must be the exact same value in auth-service and workout-service.
INTERNAL_SERVICE_SECRET="generate-a-long-random-secret-shared-with-auth-and-workout-service"
# Compose service names, not localhost — Docker's internal DNS resolves them.
AUTH_SERVICE_URL=http://auth-service:3001
WORKOUT_SERVICE_URL=http://workout-service:3002
PORT=8000
CORS_ORIGIN="https://your-frontend-domain.com"
RATE_LIMIT_MAX="100"
