# Copy to workout-service.env (gitignored) and fill in real production values.
DATABASE_URL="postgresql://personaltrainr:CHANGE_ME_SAME_AS_POSTGRES_PASSWORD@postgres:5432/personaltrainr?schema=public"
# Must be the exact same value as auth-service's and api-gateway's INTERNAL_SERVICE_SECRET.
INTERNAL_SERVICE_SECRET="generate-a-long-random-secret-shared-with-auth-and-workout-service"
PORT=3002
CORS_ORIGIN="https://your-frontend-domain.com"
RATE_LIMIT_MAX="100"
