# URL pública do api-gateway. Para apontar para o backend local, use o IP da
# máquina na rede (ex: http://192.168.0.10:8000) — "localhost" no celular é o
# próprio celular.
EXPO_PUBLIC_API_URL=https://api.personaltrainr.club

# URL do site, usada nos links de cadastro, esqueci a senha, termos etc.
EXPO_PUBLIC_WEB_URL=https://www.personaltrainr.club

# Login com Google (exige development build, não funciona no Expo Go).
# Web client ID: o mesmo GOOGLE_CLIENT_ID do auth-service.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# iOS: "com.googleusercontent.apps.<id>" do client ID iOS criado no Google Cloud.
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=
