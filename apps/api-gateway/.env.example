JWT_SECRET="generate-a-long-random-secret-do-not-use-this-value"
# Must be the exact same value in auth-service and workout-service — proves
# a request was proxied through this gateway rather than hitting those
# services' own public URLs directly.
INTERNAL_SERVICE_SECRET="generate-a-long-random-secret-shared-with-auth-and-workout-service"
AUTH_SERVICE_URL=http://localhost:3001
WORKOUT_SERVICE_URL=http://localhost:3002
PORT=8000
CORS_ORIGIN="https://your-frontend-domain.com"
RATE_LIMIT_MAX="100"
