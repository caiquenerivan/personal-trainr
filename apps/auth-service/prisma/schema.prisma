generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// 1. Adição do ADMIN (Você)
enum Role {
  ADMIN
  TRAINER
  ALUNO
}

// 2. Enumeração de Estados para o CREF
enum UF {
  AC
  AL
  AP
  AM
  BA
  CE
  DF
  ES
  GO
  MA
  MT
  MS
  MG
  PA
  PB
  PR
  PE
  PI
  RJ
  RN
  RS
  RO
  RR
  SC
  SP
  SE
  TO
}

// Status da conexão Aluno <-> Personal
enum ConnectionStatus {
  PENDING
  ACTIVE
  INACTIVE
}

enum PlanTier {
  FREE
  PRO
  UNLIMITED
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
}

model User {
  id           String    @id @default(uuid())
  name         String
  username     String    @unique // Novo: Único geral
  email        String    @unique
  passwordHash String?   // opcional: contas OAuth-only não têm senha
  role         Role      @default(ALUNO)
  isActive     Boolean   @default(true)
  emailVerified Boolean  @default(false)

  // Dados Gerais Novos e Antigos
  avatarUrl    String?
  phone        String?
  instagram    String?   // Novo
  bio          String?   // Novo
  weight       Float?
  height       Float?
  birthDate    DateTime?
  createdAt    DateTime  @default(now())

  // 2FA (TOTP)
  twoFactorSecret      String?   // cifrado (AES-256-GCM), nunca texto plano
  twoFactorEnabled     Boolean   @default(false)
  twoFactorBackupCodes String[]  @default([]) // hashes SHA-256 dos códigos, não os códigos em si

  // Relação 1-para-1 com o perfil de treinador
  trainerProfile TrainerProfile?

  // Relações de Conexão (Quem ele treina vs Quem o treina)
  students TrainerStudentConnection[] @relation("TrainerToConnection")
  trainers TrainerStudentConnection[] @relation("StudentToConnection")

  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  oauthAccounts           OAuthAccount[]
  subscription            Subscription?
}

// 5. Tokens de redefinição de senha
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Tokens de confirmação de e-mail
model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Contas de login social vinculadas (Fase 3 usa este model; já criado
// agora para evitar múltiplas migrations)
enum OAuthProvider {
  GOOGLE
  APPLE
}

model OAuthAccount {
  id             String        @id @default(uuid())
  userId         String
  provider       OAuthProvider
  providerUserId String
  email          String?
  createdAt      DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
}

// 3. Tabela exclusiva para dados profissionais do Personal
model TrainerProfile {
  id              String  @id @default(uuid())
  userId          String  @unique
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  cref            String  @unique
  crefState       UF
  crefCity        String
  experienceYears Int?
  specialties     String? // Ex: "Hipertrofia, Emagrecimento"
  website         String?
}

// 6. Assinatura do plano (só para Personal Trainers)
model Subscription {
  id                  String             @id @default(uuid())
  userId              String             @unique
  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  plan                PlanTier           @default(FREE)
  status              SubscriptionStatus @default(ACTIVE)

  asaasCustomerId     String?
  asaasSubscriptionId String?
  currentPeriodEnd    DateTime?

  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
}

// 4. A Tabela Pivô de Conexão (A "Contratação")
model TrainerStudentConnection {
  id          String           @id @default(uuid())
  trainerId   String
  studentId   String
  status      ConnectionStatus @default(ACTIVE)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  trainer     User @relation("TrainerToConnection", fields: [trainerId], references: [id], onDelete: Cascade)
  student     User @relation("StudentToConnection", fields: [studentId], references: [id], onDelete: Cascade)

  // Garante que o mesmo aluno não se conecte ao mesmo professor duas vezes simultaneamente
  @@unique([trainerId, studentId])
}