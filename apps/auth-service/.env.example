DATABASE_URL="postgresql://user:password@localhost:5432/personaltrainr?schema=public"
JWT_SECRET="generate-a-long-random-secret-do-not-use-this-value"
# Must be the exact same value as api-gateway's INTERNAL_SERVICE_SECRET.
INTERNAL_SERVICE_SECRET="generate-a-long-random-secret-shared-with-auth-and-workout-service"
PORT=3001
CORS_ORIGIN="https://your-frontend-domain.com"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
FRONTEND_URL="http://localhost:3000"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
ASAAS_API_URL="https://sandbox.asaas.com/api/v3"
ASAAS_API_KEY=""
ASAAS_WEBHOOK_TOKEN="generate-a-long-random-secret-do-not-use-this-value"
RATE_LIMIT_MAX="100"
# 2FA: chave de 32 bytes em base64 usada para cifrar o secret TOTP em repouso.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOTP_ENCRYPTION_KEY="generate-a-32-byte-base64-key-do-not-use-this-value"
TWO_FA_RATE_LIMIT_MAX="5"
